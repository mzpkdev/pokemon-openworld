  "consumerSchemas": [
    {"domain": "checkpoints", "paths": ["src/**/*.c", "data/**/*.inc", "data/**/*.s"], "patterns": ["\\b(?P<symbol>HEAL_LOCATION_[A-Za-z0-9_]+)\\b", "\\b(?P<symbol>WARP_ID_(?:NONE|SECRET_BASE|DYNAMIC))\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["HEAL_LOCATION_", "WARP_ID_"]}},
    {"domain": "destinations", "paths": ["src/region_map.c", "src/**/*.json"], "patterns": ["\\b(?P<symbol>FLAG_(?:LANDMARK|WORLD_MAP)_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["FLAG_LANDMARK_", "FLAG_WORLD_MAP_", "MAPSEC_"]}},
    {"domain": "facilities", "paths": ["src/battle_frontier.c", "src/frontier_util.c", "src/trainer_hill.c", "data/**/*.s", "data/**/*.inc"], "patterns": ["\\b(?P<symbol>FRONTIER_FACILITY_(?:TOWER|DOME|PALACE|ARENA|FACTORY|PIKE|PYRAMID))\\b", "\\b(?P<symbol>HILL_MODE_[A-Za-z0-9_]+)\\b", "\\b(?P<symbol>FACILITY_BATTLE_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["FRONTIER_FACILITY_", "FACILITY_BATTLE_", "HILL_MODE_"]}},
    {"domain": "flags", "paths": ["src/**/*.c", "data/**/*.inc", "data/**/*.s"], "patterns": ["Flag(?:Get|Set|Clear|Toggle)\\(\\s*(?P<symbol>FLAG_(?!TEXT_SPEED_INSTANT\\b)[A-Za-z0-9_]+)", "^\\s*(?:setflag|clearflag|checkflag)\\s+(?P<symbol>FLAG_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["FLAG_"], "exclude": ["FLAG_TEXT_SPEED_INSTANT"]}},
    {"domain": "gameStats", "paths": ["src/**/*.c", "data/**/*.s", "data/**/*.inc"], "patterns": ["(?:Get|Set|Increment)GameStat\\(\\s*(?P<symbol>GAME_STAT_[A-Za-z0-9_]+)", "^\\s*incrementgamestat\\s+(?P<symbol>GAME_STAT_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["GAME_STAT_"]}},
    {"domain": "metLocations", "paths": ["src/**/*.c", "include/**/*.h"], "patterns": ["\\b(?P<symbol>METLOC_(?:EGG|IN_GAME_TRADE|FATEFUL_ENCOUNTER))\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["METLOC_"]}},
    {"domain": "rewardState", "paths": ["src/**/*.c", "data/**/*.inc", "data/**/*.s"], "patterns": ["Flag(?:Get|Set|Clear|Toggle)\\(\\s*(?P<symbol>FLAG_(?:RECEIVED|GOT|REWARD)_[A-Za-z0-9_]+)", "^\\s*(?:setflag|clearflag|checkflag)\\s+(?P<symbol>FLAG_(?:RECEIVED|GOT|REWARD)_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["FLAG_RECEIVED_", "FLAG_GOT_", "FLAG_REWARD_"]}},
    {"domain": "savedLocations", "paths": ["src/location_codecs.c", "src/region_map.c"], "patterns": ["\\b(?P<symbol>MAPSEC_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["MAPSEC_"]}},
    {"domain": "tradeState", "paths": ["src/data/trade.h", "src/**/*.c", "data/**/*.s", "data/**/*.inc"], "patterns": ["\\b(?P<symbol>INGAME_TRADE_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["INGAME_TRADE_"]}},
    {"domain": "trainerIds", "paths": ["data/**/*.inc", "data/**/*.s", "src/**/*.c"], "patterns": ["^\\s*trainerbattle(?:_[A-Za-z0-9_]+)?\\s+(?P<symbol>TRAINER_(?!BATTLE_)[A-Za-z0-9_]+)\\b", "^\\s*(?:settrainerflag|cleartrainerflag)\\s+(?P<symbol>TRAINER_(?!BATTLE_)[A-Za-z0-9_]+)\\b", "opponent[AB]\\s*=\\s*(?P<symbol>TRAINER_(?!BATTLE_)[A-Za-z0-9_]+)"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["TRAINER_"], "opcodes": ["settrainerflag", "cleartrainerflag"], "opcodePrefixes": ["trainerbattle"], "excludePrefixes": ["TRAINER_BATTLE_"]}},
    {"domain": "vars", "paths": ["src/**/*.c", "data/**/*.inc", "data/**/*.s"], "patterns": ["Var(?:Get|Set)\\(\\s*(?P<symbol>VAR_[A-Za-z0-9_]+)", "^\\s*(?:setvar|addvar|subvar|copyvar|copyvarifnotzero|setorcopyvar|specialvar)\\s+(?P<symbol>VAR_[A-Za-z0-9_]+)\\b"], "scriptTokens": {"paths": ["data/**/*.s", "data/**/*.inc"], "prefixes": ["VAR_"]}}
