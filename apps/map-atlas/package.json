{
  "name": "pokemon-openworld-map-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run generate:types && vite",
    "generate:types": "json2ts --input ../../tools/map_render/catalog.schema.json --output ../../build/map-atlas/types/catalog.d.ts --bannerComment '/* Generated by npm run generate:types. */'",
    "build": "npm run generate:types && tsc --noEmit && vite build",
    "test": "npm run generate:types && vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ol": "10.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
